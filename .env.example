# Copy this file to .env.local and fill in real values to run in "live" mode
# against the actual Google Sheets. Leave both unset (or VITE_DEMO_MODE=true)
# to run against the built-in synthetic sample data instead.

# OAuth 2.0 Client ID from a Google Cloud project (APIs & Services > Credentials).
# Authorized JavaScript origins must include wherever this app is served from
# (e.g. http://localhost:5173 for local dev).
# Enable the Google Sheets API and Google Drive API on that project.
VITE_GOOGLE_CLIENT_ID=

# The master sheet's spreadsheet ID (the long id in its URL between /d/ and /edit).
VITE_MASTER_SHEET_ID=

# Force demo mode even if the two values above are set.
VITE_DEMO_MODE=false
